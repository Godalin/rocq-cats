DECLARE PLUGIN "rocq-minks.plugin"

{
open G_vernac
open Procq.Prim
open Procq.Constr

let any_attribute = Attributes.make_attribute (fun atts -> [], atts)

let mixin_declaration = Procq.Entry.make "minks_declaration"

let struct_declaration = Procq.Entry.make "minks_struct_declaration"
(* The clause word "exports" remains available as a Rocq identifier. *)
let parent_input = Procq.Entry.of_parser "minks_parent_input"
  { parser_fun = fun kw stream ->
    match Gramlib.LStream.peek_nth kw 0 stream with
    | Some (Tok.IDENT "exports" | Tok.KEYWORD ("exports" | "with" | "," | ".")) -> Error ()
    | _ -> Ok () }

let elpi_cmd_arg = Elpi_plugin.Rocq_elpi_arg_syntax.elpi_cmd_arg
module Cmd = Elpi_plugin.Rocq_elpi_arg_HOAS.Cmd

let run_minks command ~atts args =
  let loc = Option.default (Loc.make_loc (0, 0)) (Loc.get_current_command_loc ()) in
  Elpi_plugin.Rocq_elpi_vernacular.Interp.run_program
    ~loc ["minks"; command] ~atts ~syndata:None args

(* Rocq replays this local object after generalizing the record at End.
   Elpi then sees the discharged telescope, including newly abstracted indices. *)
let rediscover_views =
  let obj = Libobject.local_object "MINKS_DISCHARGED_VIEWS"
    ~cache:ignore ~discharge:(fun name -> Some name) in
  Libobject.declare_object { obj with rebuild_function = fun name ->
    run_minks "struct" ~atts:[] [Cmd.String "#discharged"; Cmd.String name];
    name }

let parent_argument (head, args) = match head.CAst.v with
  | Constrexpr.CSort _ when args = Mixin_parameters.Regular [] -> Cmd.Term head
  | Constrexpr.CRef (name, instance) ->
    let inputs = Mixin_parameters.struct_arguments name args in
    Cmd.Term (CAst.make (Constrexpr.CAppExpl ((name, instance), inputs)))
  | _ -> CErrors.user_err (Pp.str "Expected a structure or native type head.")

let separated separator = function
  | [] -> []
  | first :: rest -> first @ List.concat_map (fun item -> separator :: item) rest

let ident_arg id = Cmd.String (Names.Id.to_string id)

let key_arg qid = Cmd.String (Libnames.string_of_qualid qid)

let bracketed arg keys =
  [Cmd.String "["] @ separated (Cmd.String ",") (List.map (fun k -> [arg k]) keys)
  @ [Cmd.String "]"]

let slot_type (head, deps) =
  let mixin = match head.CAst.v with
    | Constrexpr.CRef (name, instance) ->
      Cmd.Term (CAst.make (Constrexpr.CAppExpl ((name, instance), [])))
    | _ -> CErrors.user_err (Pp.str "Expected a mixin reference.") in
  [Cmd.String ":"; mixin] @ Option.cata (bracketed ident_arg) [] deps

let record_name (name, universes) =
  let universes = Option.map (fun decl ->
    let open UState in
    { decl with univdecl_instance = List.map (fun level -> level, None) decl.univdecl_instance }
  ) universes in
  name, universes

let declare_struct ~atts ((name, universes), binders, parents, slots, tail) =
  let record_id = record_name (name, universes) in
  let header = record_id, binders in
  let name = Names.Id.to_string name.CAst.v in
  let parents = match parents with
    | None -> []
    | Some [] -> CErrors.user_err (Pp.str "Expected a parent after extends.")
    | Some ps -> Cmd.String "extends" :: separated (Cmd.String ",")
        (List.map (fun p -> [parent_argument p]) ps)
  in
  let components = Option.cata (fun entries ->
    Cmd.String "with" :: separated (Cmd.String ",") entries) [] slots in
  let args = parents @ components @ tail in
  let assemble () = match binders, universes with
  | [], None -> run_minks "struct" ~atts (Cmd.String name :: args)
  | _ ->
    (* Elaborate the parent applications and mixin heads together, under
       the actual header and universe declaration. Anonymous lets retain
       the terms without introducing names visible to later inputs. *)
    let section_names = Environ.ids_of_named_context_val
        (Environ.named_context_val (Global.env ())) in
    let _names = Mixin_parameters.parameter_names (snd record_id) binders
      |> List.fold_left (fun seen -> function
        | Names.Name.Name id ->
          if Names.Id.Set.mem id seen then
            CErrors.user_err Pp.(str "Duplicate structure parameter: " ++ Names.Id.print id);
          Names.Id.Set.add id seen
        | _ -> CErrors.user_err (Pp.str "Structure parameters must have names.")
      ) section_names in
    let open Constrexpr in
    let stop = CAst.make (CSort (None, Glob_term.UNamed [CProp, 0])) in
    let inputs, tokens = List.fold_right (fun arg (body, tokens) -> match arg with
      | Cmd.Term t ->
        Constrexpr_ops.mkLetInC (CAst.make Names.Name.Anonymous, t, None, body),
        Cmd.String "#term" :: tokens
      | _ -> body, arg :: tokens) args (stop, []) in
    let poly = CAst.make ("universes", Attributes.VernacFlagList
        [CAst.make ("polymorphic", Attributes.VernacFlagEmpty)]) in
    let declaration : Cmd.raw = Cmd.ConstantDecl { name = [name]; atts = [poly];
      udecl = universes; typ = (binders, Some inputs); body = None; red = None } in
    run_minks "struct" ~atts (declaration :: tokens) in
  Packed_record.with_header header assemble ();
  if Lib.sections_are_opened () then Lib.add_leaf (rediscover_views name)

let declare_mixin ~atts decl parents =
  let parents = List.map (fun p ->
    let name, levels, args = Mixin_parameters.read_parent p in
    Nametab.locate name, levels, args) parents in
  let decl, roles, witnesses =
    Mixin_parameters.add_to_declaration parents decl in
  let reference = Names.GlobRef.IndRef
      (Packed_record.declare_native ~atts (Vernacexpr.Class true) decl) in
  let name = Libnames.string_of_path (Nametab.path_of_global reference) in
  let ref_arg r = Cmd.String (Libnames.string_of_path (Nametab.path_of_global r)) in
  let role_args = function
    | Mixin_parameters.Value -> [Cmd.String "ordinary"]
    | Mixin_parameters.Mixin None -> [Cmd.String "witness"]
    | Mixin_parameters.Mixin (Some key) ->
      [Cmd.String "selected"; ident_arg key.spelling; ref_arg key.projection] in
  let args = [Cmd.String name] @ List.concat_map role_args roles @
    [Cmd.String ":"] @ List.map (fun (p, _, _) -> ref_arg p) parents @
    [Cmd.String ":"] @ List.map ref_arg witnesses in
  (* The class and the metadata belong to the same vernacular transaction. *)
  let origin = CAst.make ("minks.declaration", Attributes.VernacFlagEmpty) in
  run_minks "mixin" ~atts:[origin] args
}

GRAMMAR EXTEND Gram
  GLOBAL: mixin_declaration struct_declaration;
  struct_declaration:
    [ [ name = ident_decl; bs = LIST0 closed_binder;
        ps = OPT [ "extends"; ps = LIST0 struct_parent SEP "," -> { ps } ];
        slots = OPT [ "with"; cs = LIST1 struct_slot SEP "," -> { cs } ];
        rest = LIST0 elpi_cmd_arg -> { name, List.concat bs, ps, slots, rest } ] ];
  struct_parent:
    [ [ "@"; head = term LEVEL "0";
        args = LIST0 [ parent_input; a = term LEVEL "9" -> { a } ] ->
          { head, Mixin_parameters.Explicit args }
      | head = term LEVEL "0"; args = LIST0 struct_argument ->
          { head, Mixin_parameters.Regular args } ] ];
  struct_slot:
    [ [ key = qualid; "as"; f = ident; rhs = OPT slot_rhs ->
          { [key_arg key; Cmd.String "as"; ident_arg f] @ Option.cata slot_type [] rhs }
      | key = qualid; rhs = slot_rhs -> { key_arg key :: slot_type rhs }
      | ks = slot_keys; ns = OPT [ "as"; ns = slot_names -> { ns } ]; rhs = slot_rhs ->
          { bracketed key_arg ks @ Option.cata (fun ns -> Cmd.String "as" :: bracketed ident_arg ns) [] ns
            @ slot_type rhs }
      | "as"; ns = slot_names; rhs = slot_rhs ->
          { Cmd.String "as" :: bracketed ident_arg ns @ slot_type rhs }
      | rhs = slot_rhs -> { slot_type rhs } ] ];
  slot_keys:
    [ [ "["; ks = LIST0 qualid SEP ","; "]" -> { ks } ] ];
  slot_names:
    [ [ "["; ns = LIST0 ident SEP ","; "]" -> { ns } ] ];
  slot_rhs:
    [ [ ":"; head = term LEVEL "0"; deps = OPT slot_names -> { head, deps } ] ];
  struct_argument:
    [ [ parent_input; a = arg -> { a } ] ];
  mixin_declaration:
    [ [ coercion = OPT ">"; name = ident_decl; parameters = binders;
        parents = OPT [ "extends"; ps = LIST1 [ p = term LEVEL "10" -> { p } ] SEP ","
          -> { ps } ];
        result = OPT [ ":"; ty = lconstr -> { ty } ]; ":=";
        constructor = OPT identref; "{"; fields = mixin_fields; "}";
        inhabitant = OPT [ "as"; name = identref -> { name } ];
        notations = decl_notations ->
        { let open Vernacexpr in
          let coercion = if Option.has_some coercion then AddCoercion else NoCoercion in
          let body = RecordDecl (constructor, fields, inhabitant) in
          let decl = ((coercion, record_name name), (parameters, None), result, body) in
          (decl, notations), Option.default [] parents } ] ];
  mixin_fields:
    [ RIGHTA [ field = record_field; ";"; more = mixin_fields -> { field :: more }
             | field = record_field -> { [field] }
             | -> { [] } ] ];
END

VERNAC ARGUMENT EXTEND minks_mixin_decl
| [ mixin_declaration(decl) ] -> { decl }
END

VERNAC COMMAND EXTEND MinksMixin CLASSIFIED AS SIDEFF
| #[ atts = any_attribute ] [ "Minks.Mixin" minks_mixin_decl(declaration) ] ->
  { let decl, parents = declaration in
    declare_mixin ~atts decl parents }
END

VERNAC ARGUMENT EXTEND minks_struct_decl
| [ struct_declaration(decl) ] -> { decl }
END

VERNAC COMMAND EXTEND MinksStruct CLASSIFIED AS SIDEFF
| #[ atts = any_attribute ] [ "Minks.Struct" minks_struct_decl(declaration) ] ->
  { declare_struct ~atts declaration }
END
